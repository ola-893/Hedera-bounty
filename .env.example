NODE_ENV=development
PORT=3001
HEDERA_NETWORK=testnet
ENABLE_MAINNET=false
DATABASE_URL=.data/trading-agent.sqlite

# Hedera account used only for network client context. User funds are never custodied.
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=

# Public WalletConnect project id used by the frontend HashPack connection.
# Create one at https://cloud.reown.com and keep the app on Hedera testnet.
VITE_WALLETCONNECT_PROJECT_ID=

# Agent model provider. The deterministic parser works without this.
OPENAI_API_KEY=
USE_OPENAI_AGENT=false

# SaucerSwap live quote mode. Disabled by default so tests and demos are deterministic.
SAUCERSWAP_LIVE_QUOTES=false
SAUCERSWAP_ALLOW_DEMO_FALLBACK=true

# Optional token overrides for the allowed-token policy.
SAUCE_TOKEN_ID=0.0.1183558
XSAUCE_TOKEN_ID=0.0.1418651
WHBAR_TOKEN_ID=0.0.15058

# Safety limits.
MAX_SLIPPAGE_BPS=100
QUOTE_TTL_SECONDS=60
MAX_DEMO_TRADE_HBAR=50

# Hedera Consensus Service Topics (optional)
# Run `npx tsx scripts/provision-topics.ts` to generate these for testnet
HCS_AUDIT_TOPIC_ID=
HCS_POLICY_TOPIC_ID=
